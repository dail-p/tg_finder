# ===== Telegram Bot =====
BOT_TOKEN=123456:ABC-DEF_replace_me
# Comma-separated whitelist of Telegram user IDs allowed to use the bot
ALLOWED_USER_IDS=123456789,987654321

# ===== Telethon (channel parser user session) =====
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
TELEGRAM_SESSION_NAME=tg_finder
# Production: paste the value from `python scripts/gen_session.py`.
# Leave empty locally to use an interactive file-based session.
TELEGRAM_SESSION_STRING=

# ===== PostgreSQL =====
POSTGRES_USER=tg_finder
POSTGRES_PASSWORD=tg_finder
POSTGRES_DB=tg_finder
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tg_finder:tg_finder@localhost:5432/tg_finder

# ===== OpenAI =====
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Empty = fall back to LLM_MODEL. Prefer a cheaper model for selection and a
# stronger one for answers when your proxy/provider supports it, e.g.:
# SELECTOR_MODEL=gpt-4o-mini
# ANSWER_MODEL=gpt-4o
SELECTOR_MODEL=
ANSWER_MODEL=

# ===== Indexer / Parser =====
PARSER_HISTORY_LIMIT=1000
PARSER_BATCH_SIZE=100
INDEXER_INTERVAL_MINUTES=15
TITLE_MAX_LEN=300

# ===== Retention (auto-delete stale posts) =====
# Posts older than this are deleted automatically. 0 disables cleanup.
POST_RETENTION_DAYS=180
RETENTION_INTERVAL_HOURS=24

# ===== Search (two-step LLM pipeline) =====
SELECTOR_TOKEN_BUDGET=30000
SELECTOR_MAX_POSTS=20000
SELECTOR_MAX_SELECTED=15
ANSWER_TOKEN_BUDGET=12000
ANSWER_POST_CHAR_LIMIT=4000

# ===== Misc =====
LOG_LEVEL=INFO
ENVIRONMENT=dev
# Run mode: bot | scheduler | both (default: bot)
APP_MODE=both
