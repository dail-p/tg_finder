# ===== Telegram Bot =====
BOT_TOKEN=123456:ABC-DEF_replace_me
# Comma-separated whitelist of Telegram user IDs allowed to use the bot
ALLOWED_USER_IDS=123456789,987654321

# ===== Telethon (channel parser user session) =====
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
TELEGRAM_SESSION_NAME=tg_finder
# Session string or path; leave empty to use file-based session
TELEGRAM_SESSION_STRING=

# ===== PostgreSQL =====
POSTGRES_USER=tg_finder
POSTGRES_PASSWORD=tg_finder
POSTGRES_DB=tg_finder
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tg_finder:tg_finder@localhost:5432/tg_finder

# ===== OpenAI =====
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=gpt-4o-mini

# ===== Indexer / Parser =====
PARSER_HISTORY_LIMIT=1000
PARSER_BATCH_SIZE=100
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
EMBEDDING_BATCH_SIZE=64
INDEXER_INTERVAL_MINUTES=15

# ===== Search =====
SEARCH_TOP_K=10
SIMILARITY_THRESHOLD=0.35
HIGH_CONFIDENCE=0.7
MEDIUM_CONFIDENCE=0.4

# ===== Misc =====
LOG_LEVEL=INFO
ENVIRONMENT=dev
